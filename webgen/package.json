{
  "name": "passcard42",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pure front-end dn42 passport-card generator, built with Vue 3, TypeScript and SVG.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:card-svg": "node scripts/sync-card-svg.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@vicons/ionicons5": "^0.13.0",
    "browser-image-compression": "^2.0.2",
    "cropperjs": "^2.3.1",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "naive-ui": "2.45.3",
    "opentype.js": "1.3.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "1.3.10",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
