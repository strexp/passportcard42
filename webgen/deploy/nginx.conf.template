# passcard42 vhost (container).
#
# This file is rendered by the official nginx image's
# /docker-entrypoint.d/20-envsubst-on-templates.sh step into
# /etc/nginx/conf.d/default.conf, substituting the *defined* environment
# variables below. Set them on the container:
#
#   PASSCARD42_FRONTEND_HOST  listen address (default 0.0.0.0)
#   PASSCARD42_FRONTEND_PORT  listen port    (default 80)
#
# Only these two placeholders are used; the lowercase nginx variables ($uri, …)
# are left untouched because no environment variable of that name is defined.

server {
    listen ${PASSCARD42_FRONTEND_HOST}:${PASSCARD42_FRONTEND_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    server_tokens off;

    # Never emit absolute redirects: behind a reverse proxy nginx only knows the
    # internal scheme/port, so a relative Location header is the correct one.
    absolute_redirect off;

    # The app uses inline styles, data: URLs and blob downloads, so no CSP here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        application/wasm;

    # Vite emits content-hashed files under /assets/.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    location /fonts/ {
        try_files $uri =404;
        expires 30d;
        access_log off;
    }

    location = /favicon.svg {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
